#. Plugin Name of the plugin
#: siteproof.php
msgid "Siteproof – AI Content Audit"
msgstr "Siteproof – KI-Content-Audit"

#. Plugin URI of the plugin
#: siteproof.php
msgid "https://siteproof.markus-freise.de"
msgstr "https://siteproof.markus-freise.de"

#. Description of the plugin
#: siteproof.php
msgid "Audits every page in the admin: SEO, load time, content (heading structure, AI proofreading), images, links and accessibility, with a site-wide assessment, traffic-light ratings and a comparison with the previous run."
msgstr "Prüft jede Seite im Backend: SEO, Ladezeit, Inhalt (Headline-Struktur, KI-Korrekturlesen), Bilder, Links und Barrierefreiheit – mit seitenübergreifender Gesamteinschätzung, Ampel-Bewertung und Vergleich mit dem letzten Lauf."

#. Author of the plugin
#: siteproof.php
msgid "Markus Freise"
msgstr "Markus Freise"

